end;

// 左下角自定义品牌标签
var
  CustomLabel: TLabel;

procedure UpdateLabelPosition;
var
  BevelBottom, FormBottom, MidPoint: Integer;
begin
  if Assigned(CustomLabel) then
  begin
    BevelBottom := WizardForm.Bevel.Top + WizardForm.Bevel.Height;
    FormBottom := WizardForm.ClientHeight;
    MidPoint := (BevelBottom + FormBottom) div 2;

    CustomLabel.Left := WizardForm.ClientWidth * 2 div 100;
    CustomLabel.Top := MidPoint - CustomLabel.Height div 2;
  end;
end;

procedure WizardFormResize(Sender: TObject);
begin
  UpdateLabelPosition;
end;

