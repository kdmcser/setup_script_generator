end;

procedure ComponentsListKeyUp(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  if DefaultCompKeyUp <> nil then
    DefaultCompKeyUp(Sender, Key, Shift);
  UpdateComponentDesc;
