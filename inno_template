procedure TypesComboChange(Sender: TObject);
begin
  if DefaultTypeChange <> nil then
    DefaultTypeChange(Sender);
  UpdateComponentDesc;
end;

procedure InitComponentDesc;
begin
${__component_descs__}
  DescLabel := TNewStaticText.Create(WizardForm);
  DescLabel.Parent := WizardForm.SelectComponentsPage;
  DescLabel.AutoSize := False;
  DescLabel.WordWrap := True;
  LayoutDescLabel;

  // 先保存 Inno 内置处理器，再替换为自己的处理器（自定义处理器内部会转发）
  DefaultCompClick := WizardForm.ComponentsList.OnClick;
  DefaultCompClickCheck := WizardForm.ComponentsList.OnClickCheck;
  DefaultCompKeyDown := WizardForm.ComponentsList.OnKeyDown;
  DefaultCompKeyUp := WizardForm.ComponentsList.OnKeyUp;
  DefaultTypeChange := WizardForm.TypesCombo.OnChange;

  WizardForm.ComponentsList.OnClick := @ComponentsListClick;
  WizardForm.ComponentsList.OnClickCheck := @ComponentsListClickCheck;
  WizardForm.ComponentsList.OnKeyDown := @ComponentsListKeyDown;
  WizardForm.ComponentsList.OnKeyUp := @ComponentsListKeyUp;
  WizardForm.TypesCombo.OnChange := @TypesComboChange;
  UpdateComponentDesc;
end;

procedure InitializeWizard();
begin
  InitComponentDesc;

  CustomLabel := TLabel.Create(WizardForm);
  CustomLabel.Parent := WizardForm;
  CustomLabel.Caption := '制作：VCMI团队  汉化：英雄无敌3增强版VCMI团队';
  CustomLabel.Font.Color := clGray;
  CustomLabel.Font.Size := 9;
  CustomLabel.Font.Style := [fsBold];
  CustomLabel.AutoSize := True;
  CustomLabel.Transparent := True;

  UpdateLabelPosition;
  CustomLabel.BringToFront;

  WizardForm.OnResize := @WizardFormResize;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if Assigned(CustomLabel) then
  begin
    CustomLabel.BringToFront;
    UpdateLabelPosition;
  end;

  // 此时组件列表已按页面实际尺寸完成布局，需要重新计算描述位置与两行高度
  if CurPageID = wpSelectComponents then
  begin
    LayoutDescLabel;
    UpdateComponentDesc;
  end;
end;
