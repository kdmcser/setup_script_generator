  if DefaultCompClickCheck <> nil then
    DefaultCompClickCheck(Sender);
  UpdateComponentDesc;
end;

procedure ComponentsListKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  if DefaultCompKeyDown <> nil then
    DefaultCompKeyDown(Sender, Key, Shift);
